# Node.js >= 22.13; không commit .env.local
APP_PASSWORD=
# Tối thiểu 32 ký tự ngẫu nhiên; mật khẩu ít nhất 12 ký tự
SESSION_SECRET=
DATABASE_PATH=./data/medical.sqlite
AI_PROVIDER=none
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
# Web/Meta chưa được triển khai trong MVP; không nhập cookie hay mật khẩu Facebook.

# URL chính xác khi chạy sau reverse proxy HTTPS, không có dấu / cuối
APP_ORIGIN=
